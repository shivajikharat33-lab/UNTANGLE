# Copy this file to backend/.env if you want to override the defaults.
# The API reads these names. Do not commit backend/.env. Do not put a real access code here.
# Public hosting steps are in docs/deployment.md.
#
# When DATABASE_URL is unset, the app uses <repo>/data/untangle.db.
# The relative URL below works when you start uvicorn from the backend folder.
DATABASE_URL=sqlite:///../data/untangle.db
UPLOAD_DIR=../data/uploads
CACHE_DIR=../data/cache
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=40
JOB_TIMEOUT_SECONDS=600
INSPECT_TIMEOUT_SECONDS=30
ZIP_MAX_UNCOMPRESSED_BYTES=209715200
ZIP_MAX_ENTRIES=2000
UPLOAD_RATE_LIMIT=30
HEAVY_RATE_LIMIT=120
ACCESS_RATE_LIMIT=8
UPLOAD_RATE_WINDOW_SECONDS=60
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Extra browser origins, comma-separated. Never use *.
# Local default FRONTEND_ORIGIN is http://127.0.0.1:5173.
# On Render, FRONTEND_ORIGIN must be the live Vercel origin:
# https://untangle-coral.vercel.app
# Keep CORS_ORIGINS=http://127.0.0.1:5173 so a local browser can still call the hosted API.
# This app uses SQLite (DATABASE_URL). It does not use MongoDB.
CORS_ORIGINS=
LOG_LEVEL=INFO
# Leave empty for local development with no gate. Set it only on the server.
DEMO_ACCESS_CODE=
ACCESS_TOKEN_TTL_SECONDS=43200
PUBLIC_DEMO_MODE=false
DEMO_SEED_PROCESS=true
MODIFY_ENABLED=true
ASK_GRAPH_LLM_ENABLED=false
FEWSHOT_SYMBOLS_ENABLED=false
DARK_THEME_ENABLED=false
FLOW_ANIMATION_ENABLED=false
BATCH_UPLOAD_ENABLED=false
OCR_IN_BUILD=true
# Stored for a host. This build does not call a model.
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
TAG_FUZZY_THRESHOLD=0.80
PROCESS_MIN_STROKE=1.0
SIGNAL_MAX_STROKE=0.75
SNAP_TOLERANCE=4.0
NODE_ATTACH_TOLERANCE=8.0
