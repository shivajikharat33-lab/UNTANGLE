# Copy this file to backend/.env if you want to override the defaults.
# The API reads these names. Do not commit backend/.env.
#
# When DATABASE_URL is unset, the app uses <repo>/data/untangle.db.
# The relative URL below works when you start uvicorn from the backend folder.
DATABASE_URL=sqlite:///../data/untangle.db
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=50
FRONTEND_ORIGIN=http://127.0.0.1:5173
