# Vite reads this when the dev server starts and when the production site is built.
# Local default below is fine for npm run dev.
# On Vercel (Production), set VITE_API_URL to the Render HTTPS origin from the
# Render dashboard (service untangle-api), for example:
#   https://untangle-api.onrender.com
# Then Redeploy. No trailing slash. No secrets. Never use localhost on Vercel.
# See docs/deployment.md.
VITE_API_URL=http://127.0.0.1:8000
