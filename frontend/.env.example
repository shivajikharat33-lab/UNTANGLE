# Vite reads this when the dev server starts and when the production site is built.
# If the variable is unset, the site calls http://127.0.0.1:8000.
# On Vercel, set VITE_API_URL to the Render origin, for example
# https://untangle-api.onrender.com, then redeploy. No trailing slash. No secrets.
# See docs/deployment.md.
VITE_API_URL=http://127.0.0.1:8000
